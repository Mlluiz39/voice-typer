# Configuração do refino por LLM (opcional).
#
# Copie para ~/.config/voice-typer/llm.env e preencha:
#   mkdir -p ~/.config/voice-typer
#   cp llm.env.example ~/.config/voice-typer/llm.env
#   chmod 600 ~/.config/voice-typer/llm.env
#
# Qualquer endpoint compatível com a API OpenAI funciona: DeepSeek, OpenAI,
# Groq, OpenRouter, Ollama local (http://127.0.0.1:11434/v1) ou llama.cpp.
# Para serviço local, a chave pode ficar vazia.
#
# Sem este arquivo o ditado funciona normalmente; apenas não há refino.

VT_LLM_BASE_URL=https://api.deepseek.com
VT_LLM_MODEL=deepseek-chat
VT_LLM_API_KEY=COLOQUE_SUA_CHAVE_AQUI
VT_LLM_TIMEOUT=20

# Modelos de raciocínio gastam o orçamento de tokens "pensando" e podem devolver
# resposta vazia. Deixe em 1 (padrão) para enviar reasoning.enabled=false.
# VT_LLM_DISABLE_REASONING=1
